# Copiar a .env y completar
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
# Supabase > Connect > "Session pooler" (funciona por IPv4)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Secreto entre notificaciones y api (inventa uno)
SERVICE_TOKEN=cambia-esto-1
# Dejar NOTIFY_URL vacío = envío SIMULADO. Luego poner la URL de Vercel.
NOTIFY_URL=
NOTIFY_TOKEN=cambia-esto-2
